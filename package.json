{
  "name": "oddvest",
  "version": "1.0.0",
  "description": "OddBird's Trello Power-up for Harvest integration",
  "repository": "github:oddbird/oddvest",
  "author": "Carl Meyer <carl@oddbird.net>",
  "contributors": [
    "Jonny Gerig Meyer <jonny@oddbird.net>",
    "Kit La Touche <kit@oddbird.net>"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "engines": {
    "node": "^24"
  },
  "scripts": {
    "prettier:js": "prettier --write \"**/*.{js,ts}\"",
    "prettier:other": "prettier --write \"**/*.{json,yml,md,html}\"",
    "eslint": "eslint \"**/*.{js,ts}\" --fix",
    "tsc": "tsc",
    "lint": "run-s prettier:js prettier:other eslint tsc",
    "test:watch": "jest --watchAll",
    "test": "jest",
    "watch": "rollup -c --watch",
    "build": "rollup -c",
    "prepare": "husky"
  },
  "dependencies": {
    "isomorphic-fetch": "^3.0.0",
    "lodash.uniqby": "^4.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/bluebird": "^3.5.42",
    "@types/isomorphic-fetch": "^0.0.39",
    "@types/lodash.uniqby": "^4.7.9",
    "@types/node": "^24",
    "bluebird": "^3.7.2",
    "core-js": "^3.49.0",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "fetch-mock": "^12.6.0",
    "flush-promises": "^1.0.2",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "^17.0.0",
    "lint-staged": "^17.0.8",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.4",
    "rollup": "^4.62.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yml,md,html}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.17.0"
}
